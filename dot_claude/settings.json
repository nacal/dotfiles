{
  "permissions": {
    "allow": [
      "Edit(**)",
      "Grep(**)",
      "Glob(**)",
      "LS(**)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(xargs:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(tr:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(type:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(whoami:*)",
      "Bash(id:*)",
      "Bash(uname:*)",
      "Bash(hostname:*)",
      "Bash(uptime:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(md5:*)",
      "Bash(shasum:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(mkdir:*)",
      "Bash(npx:*)",
      "Bash(npm view:*)",
      "Bash(cmux:*)",
      "Bash(docker ps:*)",
      "Bash(docker system:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:wezterm.org)",
      "WebFetch(domain:iterm2.com)"
    ],
    "deny": [
      "Read(//etc/**)",
      "Edit(//etc/**)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Bash(passwd:*)",
      "Bash(history:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(rsync:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(socat:*)",
      "Bash(ssh:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(nmap:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "permissions-audit@makikub-plugins": true,
    "slack@claude-plugins-official": true,
    "discord@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "makikub-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/makikub/claude-code-plugin.git"
      }
    }
  },
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
