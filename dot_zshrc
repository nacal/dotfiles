# fzf
function fzf-src () {
  local selected_dir=$(ghq list -p | fzf \
    --query "$LBUFFER" \
    --preview 'tree -L 1 -C {}' \
    --preview-window 'right:50%' \
    --height '60%' \
    --reverse \
    --border \
    --prompt 'repo> '
  )
  if [ -n "$selected_dir" ]; then
    BUFFER="cd ${selected_dir}"
    zle accept-line
  fi
  zle clear-screen
}
zle -N fzf-src
bindkey '^]' fzf-src
function fzf-notes-grep () {
  local selected=$(rg --line-number --no-heading --color=always --smart-case '' "$HOME/notes" \
    | fzf --ansi \
      --delimiter ':' \
      --preview 'bat --color=always --highlight-line {2} {1}' \
      --preview-window 'right:60%:+{2}-/2' \
      --height '60%' \
      --reverse \
      --border \
      --prompt 'note grep> '
  )
  if [ -n "$selected" ]; then
    local file=$(echo "$selected" | cut -d: -f1)
    local line=$(echo "$selected" | cut -d: -f2)
    BUFFER="nvim +${line} ${file}"
    zle accept-line
  fi
  zle clear-screen
}
