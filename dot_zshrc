# OSC 7 でカレントディレクトリを通知
function osc7_cwd() {
  printf '\e]7;file://%s%s\e\\' "$HOST" "$PWD"
}

# タブタイトルを設定（ディレクトリ名 + ブランチ）
function set_tab_title() {
  local dir_name="${PWD##*/}"  # 最後のディレクトリ名だけ
  [[ "$PWD" == "$HOME" ]] && dir_name="~"

  local branch=""
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    local git_dir
    git_dir=$(git rev-parse --git-dir 2>/dev/null)
    if [[ "$git_dir" == */.git/worktrees/* ]]; then
      local repo_name="${git_dir%%/.git/worktrees/*}"
      repo_name="${repo_name##*/}"
      dir_name="${repo_name}/${dir_name}"
    fi
    printf '\e]1;%s  %s\e\\' "$dir_name" "$branch"
  else
    printf '\e]1;%s\e\\' "$dir_name"
  fi
}

