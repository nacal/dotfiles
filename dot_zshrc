    _pokemon_id=$(cat "$_pokemon_id_file")
  else
    _pokemon_id=$(printf '%04d' $(jot -r 1 1 1025))
    echo "$_pokemon_id" > "$_pokemon_id_file"
  fi
  _pokemon_path="$HOME/.cache/wezterm/pokemon/${_pokemon_id}.png"
  if [ ! -f "$_pokemon_path" ]; then
    curl -sfL --max-time 5 \
      "https://www.pokemon.co.jp/ex/30th_logo/assets/img/download/${_pokemon_id}.png" \
      -o "$_pokemon_path" 2>/dev/null
  fi
  export WEZTERM_POKEMON_PATH="$_pokemon_path"
  unset _pokemon_id _pokemon_path _pokemon_id_file

  # precmd フックで毎プロンプト前にポケモンを表示
